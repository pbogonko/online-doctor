
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---- serve stage ----
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY ngnix.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
EXPOSE 443
RUN apk add --no-cache curl
HEALTHCHECK --interval=30s --retries=3 --timeout=10s CMD curl -f http://localhost/ || exit 1